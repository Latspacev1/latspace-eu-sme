# Copy to .env.local and fill in real values. Never commit .env.local.

# ──────────────────────────────────────────────────────────────────────────
# Reporting / VSME Narrative AI assistant (chat + write routes)
# ──────────────────────────────────────────────────────────────────────────

# AGENT_DISPATCH_MODE controls how /api/reporting/chat and /api/reporting/write
# run the agent:
#   "local"   — spawns agent-runner/runner.ts as a child process on this
#               machine. Required for local development since the Vercel
#               Sandbox doesn't exist outside Vercel infra.
#   "sandbox" — (default) creates a Vercel Sandbox per request. Used in prod.
AGENT_DISPATCH_MODE=local

# Anthropic API key — required for both modes. The agent calls Claude here.
# Also used by /api/dashboard/chat (AI Dashboard) for tool-use chart generation.
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI key — required for both modes. Used by the RAG retriever for
# embedding queries against the CDP/VSME document index.
VOYAGE_API_KEY=pa-...

# ──────────────────────────────────────────────────────────────────────────
# Vercel Sandbox (production only — leave commented out for local dev)
# ──────────────────────────────────────────────────────────────────────────

# AGENT_RUNNER_TARBALL_URL=https://...public.blob.vercel-storage.com/...
# AGENT_RUNNER_SNAPSHOT_ID=snap_...

# ──────────────────────────────────────────────────────────────────────────
# Clerk — authentication (sign-in / sign-up, Google + email)
# ──────────────────────────────────────────────────────────────────────────
# Clerk owns identity. Enable the sign-in methods you want (Google, email,
# etc.) in the Clerk dashboard. See docs/AUTH_SETUP.md for the full guide.
#
# Get these from: Clerk dashboard → API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Route configuration. The app uses a branded /login (Clerk <SignIn>), a
# /sign-up page, and a /post-auth server route that decides between
# /onboarding (no org yet) and /corporate/overview (existing org).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/post-auth
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/post-auth

# ──────────────────────────────────────────────────────────────────────────
# Supabase — multi-tenant orgs + VSME data platform (NOT auth)
# ──────────────────────────────────────────────────────────────────────────
# Supabase no longer handles auth (Clerk does). It still powers:
#   1. Multi-tenant organizations — organizations + memberships tables created
#      by migration 0005_auth_orgs.sql (keyed by Clerk user ids, which are text).
#   2. VSME data platform — parameters, data_points, calculated_metrics,
#      extraction_documents, dashboards, and the documents Storage bucket.
#
# Data access uses the service-role client + app-level org scoping (no Supabase
# RLS / Supabase Auth dependency).
#
# Get these values from: Supabase dashboard → Project Settings → API
#
# Public URL & anon key — safe to expose in browser bundles.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key — SERVER ONLY. Used by the onboarding API route to write
# organizations/memberships and by data API routes for reads/recalculations.
# NEVER expose in client bundles or commit to version control.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
